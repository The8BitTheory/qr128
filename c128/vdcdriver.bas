#RetroDevStudio.MetaData.BASIC:7169,BASIC V7.0 VDC,uppercase,10,10
10 GRAPHIC0
20 REM TESTPROGRAM TO USE VDC-BASIC TO DRAW QR-CODE TO VDC
30 QR$="8B05"
40 BE=PEEK(4624)+PEEK(4625)*256
50 PRINT"BASIC-END AT: $"HEX$(BE)
55 PRINT"QR-GENERATOR AT: $"QR$
60 BLOAD"VDCBASIC2D.0AC6",B0:SYS DEC("AC6")
70 F$="QR."+QR$+".BIN":PRINT"LOADING "F$"...";:BLOAD"QR."+QR$+".BIN",B0:PRINT "DONE"
80 H$="MARINETRAFFIC.COM/EN/AIS/DETAILS/SHIPS/MMSI:"
90 T$="207072329"
100 T$=H$+T$

110 I=POINTER(T$)
120 BANK1:I1=PEEK(I+1):I2=PEEK(I+2):I=PEEK(I)
130 PRINT "I1:"HEX$(I1)",I2:"HEX$(I2)",I:"I
140 PRINT "T$:"T$
150 BANK0:S=TI:SYS DEC(QR$),I,I1,I2:S=TI-S:RREGA,X,Y:BANK15
160 F=X+Y*256:L=A:PRINT "DATA AT $"HEX$(F)", L="L", TOOK "S" JIFFIES"

170 ::RGO 28,16:REM 64K VRAM
180 ::RGO 25,128:RGA 25,255-64:REM BITMAP MODE ON, NO ATTRIBUTES

# 2 SCANLINES PER CHAR, 156 SCANLINES (EACH VAL +1)
190 ::RGW 0,127
200 ::RGW 4,155
210 ::RGW 6,100
220 ::RGW 7,140
230 ::RGW 9,1
240 ::RGW 36,0

250 DISP 0:VMF 0,0,16000

260 FOR X=0TOL+1
270  RTV F+X*4,X*80,4
280 NEXT

290 INPUT "MMSI (X TO EXIT)";T$
295 IF T$="X" THEN END
300 GOTO 100
